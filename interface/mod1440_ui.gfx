# Sprites of the manager pages and the Records window (HOI4 Manager Pages). Split from the 1440p UI mod's
# interface/1440p_ui.gfx on 2026-10-21: the names stay (GFX_1440p_SG_*, GFX_1440p_medal_*, ...) because the
# generated .gui files and the players' saves carry them. The five textures of the mod's own live under
# gfx/interface/mod1440/; every other sprite is a tile or a frame of a vanilla texture.
spriteTypes = {

	# Scripted GUIs (Milestone D). A bar that script fills through its "frame" property, 0 to 100
	# (wiki/Engine-Facts.md, X17). Textures: the vanilla organisation bar of the navy list.
	progressbartype = {
		name = "GFX_1440p_SG_bar"
		textureFile1 = "gfx/interface/navieslist_bar_org.dds"
		textureFile2 = "gfx/interface/navieslist_bar_bg.dds"
		size = { x = 105 y = 12 }
		effectFile = "gfx/FX/progress.lua"
		horizontal = yes
		steps = 100
	}

	# A column of a scripted graph: the same bar standing up, filled from below, 0 to 200.
	progressbartype = {
		name = "GFX_1440p_SG_column"
		textureFile1 = "gfx/interface/navieslist_bar_org.dds"
		textureFile2 = "gfx/interface/navieslist_bar_bg.dds"
		size = { x = 9 y = 300 }
		effectFile = "gfx/FX/progress.lua"
		horizontal = no
		steps = 200
	}

	# Column heads and row buttons of a scripted table, one sprite per width: the vanilla header tile
